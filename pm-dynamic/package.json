{
  "name": "ts-nft-marketplace-cu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "anvil0": "anvil --load-state marketplace-anvil.json --block-time 2",
    "anvil": "anvil",
    "anvil1": "anvil --block-time 5",
    "reset-indexer": "cd NftMarketplace && docker compose down && docker volume rm marketplaceindexer_postgres_data",
    "reset-indexer2": "cd NftMarketplace && rindexer delete",
    "indexer": "cd NftMarketplace && rindexer start all",
    "test:unit": "vitest",
    "test:cache": "pnpm synpress",
    "test:e2e": "pnpm exec playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.4",
    "@tanstack/react-query": "^5.69.0",
    "@types/uuid": "^10.0.0",
    "@wagmi/core": "^2.16.7",
    "graphql": "^16.10.0",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "uuid": "^11.1.0",
    "viem": "2.x",
    "wagmi": "^2.14.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@synthetixio/synpress": "^4.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa"
}
